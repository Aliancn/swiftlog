# SwiftLog Environment Configuration
# Copy this file to .env and fill in your values

# Database
POSTGRES_PASSWORD=changeme

# Security
JWT_SECRET=your-secure-random-secret-key-here
JWT_EXPIRATION=2h

# API Key Encryption (32 bytes base64-encoded)
# Generate with: openssl rand -base64 32
# Leave empty for development mode (not recommended for production)
ENCRYPTION_KEY=

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000

# Admin User (created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Environment (development/production)
# Note: production requires ENCRYPTION_KEY to be set
ENVIRONMENT=development
LOG_LEVEL=info

# Note: OpenAI API configuration is managed per-user in the web interface
# No need to set OPENAI_API_KEY here - users configure it in their settings
