# SwiftLog Environment Configuration
# Copy this file to .env and fill in your values
#
# This is the unified configuration file for all SwiftLog services.
# All services read from this file located in the project root.

# =============================================================================
# Public Access Configuration
# =============================================================================
# PUBLIC_URL: The URL where users will access your service
# This is used for CORS configuration and documentation
#
# Architecture:
#   Development:
#     User → http://localhost → Docker nginx:${NGINX_PORT} → services
#
#   Production (with external nginx):
#     User → https://swiftlog.whuiosclub.cn (PUBLIC_URL)
#          → Server external nginx (80/443)
#          → localhost:${NGINX_PORT}
#          → Docker nginx (container port 80)
#          → services
#
PUBLIC_URL=http://localhost

# The port Docker nginx will be mapped to on the host machine
# Development: 80 (direct access)
# Production: 8080 or other port (behind external nginx)
NGINX_PORT=80
# WS_PORT=8081
# API_PORT=8080

# gRPC port for CLI tool connections (direct exposure, not through nginx)
# Users should connect to ${PUBLIC_URL}:${GRPC_PORT} for production
# or localhost:${GRPC_PORT} for development
GRPC_PORT=50051

# =============================================================================
# Database Configuration
# =============================================================================
# POSTGRES_USER=swiftlog
# POSTGRES_PASSWORD=changeme
# POSTGRES_DB=swiftlog

# =============================================================================
# Security Configuration
# =============================================================================
# JWT Secret (REQUIRED in production, min 32 characters)
# Generate with: openssl rand -base64 32
# JWT_SECRET=your-secure-random-secret-key-change-this-in-production
# JWT_EXPIRATION=2h

# API Key Encryption Key (REQUIRED in production)
# Generate with: openssl rand -base64 32
# Leave empty for development mode (uses deterministic key)
# ENCRYPTION_KEY=

# CORS Configuration
# IMPORTANT: In production, this MUST be set to your PUBLIC_URL
#
# Development: Include all local access points for debugging
# Production: Set to PUBLIC_URL only (e.g., https://swiftlog.example.com)
#
# If not set in production deployment, will automatically use PUBLIC_URL
# CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080

# =============================================================================
# Admin User (created on first startup if no users exist)
# =============================================================================
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123

# =============================================================================
# Application Settings
# =============================================================================
# Environment: development or production
# Production mode enforces:
# - Strong JWT_SECRET (32+ chars, no weak patterns)
# - ENCRYPTION_KEY must be set
# - Enhanced security validations
# ENVIRONMENT=development
# LOG_LEVEL=info

