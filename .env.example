# SwiftLog Environment Configuration
# Copy this file to .env and fill in your values
#
# This is the unified configuration file for all SwiftLog services.
# All services read from this file located in the project root.

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=swiftlog
POSTGRES_PASSWORD=changeme
POSTGRES_DB=swiftlog
DATABASE_URL=postgres://swiftlog:changeme@postgres:5432/swiftlog?sslmode=disable

# =============================================================================
# Loki Configuration
# =============================================================================
LOKI_URL=http://loki:3100

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://redis:6379

# =============================================================================
# API Configuration
# =============================================================================
API_PORT=8080

# =============================================================================
# WebSocket Configuration
# =============================================================================
WS_PORT=8081

# =============================================================================
# gRPC Ingestor Configuration
# =============================================================================
GRPC_PORT=50051

# =============================================================================
# Security Configuration
# =============================================================================
# JWT Secret (REQUIRED in production, min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secure-random-secret-key-change-this-in-production
JWT_EXPIRATION=2h

# API Key Encryption Key (REQUIRED in production)
# Generate with: openssl rand -base64 32
# Leave empty for development mode (uses deterministic key)
ENCRYPTION_KEY=

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# Admin User (created on first startup if no users exist)
# =============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# =============================================================================
# Application Settings
# =============================================================================
# Environment (development/production)
# production mode enforces:
# - Strong JWT_SECRET (32+ chars, no weak patterns)
# - ENCRYPTION_KEY must be set
# - Enhanced security validations
ENVIRONMENT=development
LOG_LEVEL=info

# =============================================================================
# Frontend Configuration
# =============================================================================
# These are used by Next.js frontend (must have NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8081
NEXT_PUBLIC_APP_NAME=SwiftLog
NEXT_PUBLIC_ENVIRONMENT=development

# =============================================================================
# Production Deployment Notes
# =============================================================================
# When deploying to production:
# 1. Set ENVIRONMENT=production
# 2. Generate strong JWT_SECRET: openssl rand -base64 32
# 3. Generate ENCRYPTION_KEY: openssl rand -base64 32
# 4. Update POSTGRES_PASSWORD to a strong password
# 5. Update ADMIN_PASSWORD to a strong password
# 6. Update CORS_ORIGINS to your production frontend URL
# 7. Update NEXT_PUBLIC_API_URL to your production API URL
# 8. Update NEXT_PUBLIC_WS_URL to your production WebSocket URL
# 9. Set LOG_LEVEL=warn or LOG_LEVEL=error for production
